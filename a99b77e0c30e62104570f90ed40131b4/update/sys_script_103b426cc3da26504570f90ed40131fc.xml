        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    gs.sleep(1000); // Aguarda 1 segundo para garantir que o anexo esteja salvo

    var grAttach = new GlideRecord('sys_attachment');
    grAttach.addQuery('table_name', current.getTableName());
    grAttach.addQuery('table_sys_id', current.sys_id);
    grAttach.orderByDesc('sys_created_on');
    grAttach.setLimit(1);
    grAttach.query();

    if (grAttach.next()) {
        var imgUrl = '/sys_attachment.do?sys_id=' + grAttach.sys_id;
        var html = '<img src="' + imgUrl + '" style="max-width:100%; height:auto;" />';

        // Atualiza o próprio registro, com GlideRecord externo para evitar loop
        var rec = new GlideRecord(current.getTableName());
        if (rec.get(current.sys_id)) {
            rec.u_poster = html;
            rec.u_info = html;
            rec.update();
            gs.info("Evangeline Poster atualizado com imagem: " + imgUrl);
        }
    } else {
        gs.info("Evangeline Nenhum anexo encontrado para " + current.sys_id);
    }

})(current, previous);
]]></script>
