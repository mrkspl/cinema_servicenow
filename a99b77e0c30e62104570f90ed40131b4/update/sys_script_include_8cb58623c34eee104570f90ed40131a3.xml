        <script><![CDATA[var MoviesUtils = Class.create();
MoviesUtils.prototype = {
    initialize: function() {
    },

	getUltimaQuinta: function() {
        var now = new GlideDateTime();
        var dayOfWeek = parseInt(now.getDayOfWeekLocalTime()); // 1 (domingo) até 7 (sábado)

        var diasAtras = (dayOfWeek >= 5) ? dayOfWeek - 5 : 7 - (5 - dayOfWeek);
        now.subtractDays(diasAtras);
        now.setDisplayValue(now.getDate() + ' 00:00:00');
        return now;
    },


    type: 'MoviesUtils'
};]]></script>
