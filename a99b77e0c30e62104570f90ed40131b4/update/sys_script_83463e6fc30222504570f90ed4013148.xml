        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

var gdt = new GlideDateTime(current.u_horario_inicio);

gdt.setValue(gdt.getYearLocalTime() + "-" + 
             pad((gdt.getMonthLocalTime()+1)) + "-" + 
             pad(gdt.getDayOfMonthLocalTime()) + " " + 
             pad(gdt.getHourLocalTime()) + ":" + 
             pad(gdt.getMinuteLocalTime()) + ":00");

function pad(n) {
  return n < 10 ? '0' + n : n;
}

var dia = pad(gdt.getDayOfMonthLocalTime());
var mes = pad(gdt.getMonthLocalTime() + 1);
var ano = gdt.getYearLocalTime();

var hora = pad(gdt.getHourLocalTime());
var minuto = pad(gdt.getMinuteLocalTime());
var segundo = "00";

var dataFormatada = dia + "/" + mes + "/" + ano + " " + hora + ":" + minuto + ":" + segundo;

})(current, previous);]]></script>
