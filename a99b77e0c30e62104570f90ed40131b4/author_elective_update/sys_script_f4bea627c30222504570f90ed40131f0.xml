        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    if (!current.u_horario_inicio) {
        return;
    }

    var gdt = new GlideDateTime(current.u_horario_inicio);

    // Pega o primeiro dia do mês (ano, mês, dia)
    var firstDay = new GlideDateTime();
    firstDay.setYear(gdt.getYearLocalTime());
    firstDay.setMonth(gdt.getMonthLocalTime());
    firstDay.setDayOfMonth(1);
    firstDay.setDisplayValue(firstDay.getLocalDate() + ' 00:00:00');

    // Função para achar a primeira quinta-feira do mês
    function getFirstThursday(date) {
        var tempDate = new GlideDateTime(date);
        for (var i = 0; i < 7; i++) {
            if (tempDate.getDayOfWeek() == 5) { // quinta = 5
                return tempDate;
            }
            tempDate.addDays(1);
        }
        return tempDate;
    }

    var firstThursday = getFirstThursday(firstDay);

    // Diferença em milissegundos
    var diffMillis = gdt.getNumericValue() - firstThursday.getNumericValue();
    var diffDays = Math.floor(diffMillis / (1000 * 60 * 60 * 24));

    var weekNumber = diffDays >= 0 ? Math.floor(diffDays / 7) + 1 : 1;

    current.u_sessao = 'Semana ' + weekNumber;

})(current, previous);
]]></script>
